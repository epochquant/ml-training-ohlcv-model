# ============================================================
# EpochQuant Kronos ML Training — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values.
# .env is git-ignored and must NEVER be committed.
# ============================================================

# ----------------------------------------------------------
# Google Cloud Platform (GCP) Core Setup
# ----------------------------------------------------------
GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID
GCP_REGION=us-central1
GCP_SERVICE_ACCOUNT=ML_SERVICE_ACCOUNT@YOUR_GCP_PROJECT_ID.iam.gserviceaccount.com

# ----------------------------------------------------------
# Google Cloud Storage (GCS)
# ----------------------------------------------------------
GCS_BUCKET_NAME=YOUR_BUCKET_NAME  # Without gs:// prefix
GCS_DESTINATION_PREFIX=training-data
GCS_KEY_FILE= # Leave blank to use Application Default Credentials (ADC)

# ----------------------------------------------------------
# GCP Artifact Registry & Container Configuration
# ----------------------------------------------------------
ARTIFACT_REGISTRY_IMAGE=us-central1-docker.pkg.dev/YOUR_GCP_PROJECT_ID/kronos-ml/ohlcv-model-training:latest

# ----------------------------------------------------------
# Local Container Engine (Podman / Docker)
# ----------------------------------------------------------
# Default local container tool: podman (or docker)
CONTAINER_ENGINE=podman

# ----------------------------------------------------------
# Cloud Workflows — Event-Driven Trigger (gcp/deploy_workflow.ps1)
# ----------------------------------------------------------
# GCS prefix Eventarc monitors. MUST differ from GCS_DESTINATION_PREFIX
# to prevent double-triggering when launch_vertex_job.py runs manually.
WORKFLOW_TRIGGER_PREFIX=training-data-workflow

# Cloud Workflow resource name deployed to GCP
WORKFLOW_NAME=kronos-training-workflow

# Eventarc trigger resource name
EVENTARC_TRIGGER_NAME=trigger-kronos-gcs-workflow-upload
