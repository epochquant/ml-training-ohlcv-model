# ============================================================
# EpochQuant Kronos ML Training — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values.
# .env is git-ignored and must NEVER be committed.
# ============================================================

# ----------------------------------------------------------
# Google Cloud Platform (GCP) Core Setup
# ----------------------------------------------------------
GCP_PROJECT_ID=YOUR_GCP_PROJECT_ID
GCP_REGION=us-central1
GCP_SERVICE_ACCOUNT=ML_SERVICE_ACCOUNT@YOUR_GCP_PROJECT_ID.iam.gserviceaccount.com

# ----------------------------------------------------------
# Google Cloud Storage (GCS)
# ----------------------------------------------------------
GCS_BUCKET_NAME=gs://epochquant-training
GCS_DESTINATION_PREFIX=training-data
GCS_KEY_FILE= # Leave blank to use Application Default Credentials (ADC)

# ----------------------------------------------------------
# GCP Artifact Registry & Container Configuration
# ----------------------------------------------------------
ARTIFACT_REGISTRY_IMAGE=us-central1-docker.pkg.dev/YOUR_GCP_PROJECT_ID/kronos-ml/ohlcv-model-training:latest

# ----------------------------------------------------------
# Local Container Engine (Podman / Docker)
# ----------------------------------------------------------
# Default local container tool: podman (or docker)
CONTAINER_ENGINE=podman
